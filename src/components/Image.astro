---
import { Image as AstroImage } from "astro:assets";

interface Props {
  source: ImageMetadata;
  altText: string;
  width?: number;
  height?: number;
  fullWidth?: boolean;
}

const { source, altText, width, height, fullWidth = false } = Astro.props;
---

<AstroImage
  class:list={[
    "rounded-lg object-contain !px-0",
    fullWidth ? "w-full h-auto max-w-none" : "max-h-[35rem] w-max",
  ]}
  src={source}
  alt={altText}
  width={width}
  height={height}
/>
