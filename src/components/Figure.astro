---
interface Props {
  caption?: string;
  fullWidth?: boolean;
}

const { caption, fullWidth = false } = Astro.props;
---

<figure class="w-full flex flex-col gap-2 items-center">
  <div
    class:list={[
      "flex justify-center w-full",
      { "*:max-h-[35rem] *:object-contain": !fullWidth },
    ]}
  >
    <slot />
  </div>
  {caption && (
    <figcaption class="text-center text-zinc-700">
      {caption}
    </figcaption>
  )}
</figure>
